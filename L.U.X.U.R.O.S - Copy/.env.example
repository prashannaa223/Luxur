# Copy this file to .env and fill in your keys (start.bat / start.sh does the copy for you).
Username=YourName
Assistantname=Luxur

# Required
GroqAPIKey=
CohereAPIKey=
# Optional: image generation
HuggingFaceAPIKey=

# Speech recognition language (e.g. en, en-US, hi-IN) and voice (run: edge-tts --list-voices)
InputLanguage=en
AssistantVoice=en-CA-LiamNeural

# Browser: auto picks the first installed of zen, helium, librewolf, firefox, brave, vivaldi, chrome, edge.
# Or name one of them, or "default" for the system default browser.
Browser=auto

# Screen reading: "on" lets the desktop agent send screenshots of the whole screen to Cohere while
# doing a task you asked for. It's skipped when the ACTIVE window looks private (banking, mail,
# chat, sign-in), but other windows on screen are visible: close private ones first. "off" disables it.
ScreenReading=on

# Optional local router (free, offline): install Ollama, then run: ollama pull qwen2.5:1.5b
# LUXUR uses it automatically when it's running, and falls back to Cohere when it isn't.
# LocalModel=qwen2.5:1.5b
# OllamaURL=http://localhost:11434

# Optional model overrides
# GroqModel=openai/gpt-oss-120b
# GroqFastModel=openai/gpt-oss-20b
# CohereModel=command-a-plus-05-2026
# GroqVisionModel=qwen/qwen3.8-27b
# ImageModel=stabilityai/stable-diffusion-xl-base-1.0
